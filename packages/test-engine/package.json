{
  "name": "@convkit/test-engine",
  "version": "0.1.1",
  "description": "Convkit conversational test engine — write and run automated WhatsApp bot tests",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@convkit/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/somaathetechster/Convkit.git"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "testing",
    "convkit",
    "test-engine"
  ]
}
