{
  "name": "@convkit/cli",
  "version": "0.1.2",
  "description": "Convkit CLI — local development environment for WhatsApp bots",
  "type": "module",
  "bin": {
    "convkit": "./bin/convkit.js"
  },
  "files": [
    "bin",
    "dist",
    "server",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "bundle": "node scripts/bundle-server.mjs",
    "prepublishOnly": "pnpm run build && node scripts/bundle-server.mjs",
    "test": "vitest"
  },
  "dependencies": {
    "@convkit/test-engine": "workspace:*",
    "@convkit/protocol": "workspace:*",
    "fastify": "^5.12.1",
    "@fastify/websocket": "^11.3.0",
    "@fastify/cors": "^11.3.0",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/somaathetechster/Convkit.git"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "convkit",
    "cli",
    "testing",
    "development"
  ]
}
